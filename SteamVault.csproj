<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SteamVault</AssemblyName>
    <RootNamespace>SteamVault</RootNamespace>
    <Version>2.6.0</Version>
    <Authors>SteamVault</Authors>
    <Description>Offline Steam depot manifest manager — download, manage, and keep your Steam game configurations up to date with no Steam client required.</Description>
    <Copyright>MIT License</Copyright>
    <!-- Application icon — used for EXE icon, taskbar, system tray -->
    <ApplicationIcon>SteamVault.ico</ApplicationIcon>
    <!-- Self-contained publish bundles the .NET runtime. -->
    <SelfContained>true</SelfContained>
    
    <!-- SINGLE FILE EXE PUBLISH: -->
    <!-- For the standalone EXE version, uncomment the 3 lines below or publish with /p:PublishSingleFile=true -->
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    <!-- <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract> -->
    <!-- <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract> -->

    <DebugType>embedded</DebugType>
    <!-- Optional: trim unused assemblies for smaller output -->
    <!-- <PublishTrimmed>true</PublishTrimmed> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\appaccesstokens.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Data\depotkeys.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- OpenSteamTool native DLLs: bundled into the single-file EXE and extracted at runtime -->
    <Content Include="OpenSteamTool\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Discord.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the ICO and Discord logo as WPF resources -->
    <Resource Include="SteamVault.ico" />
    <Resource Include="Discord.png" />
  </ItemGroup>

</Project>