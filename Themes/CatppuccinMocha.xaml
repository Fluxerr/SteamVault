<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Color Palette — Catppuccin Mocha (Warm Brown & Cream) ═══ -->
    <Color x:Key="WindowBackgroundColor">#2A2421</Color>
    <Color x:Key="SidebarBackgroundColor">#231D1A</Color>
    <Color x:Key="SurfaceBaseColor">#38302C</Color>
    <Color x:Key="SurfaceRaisedColor">#4A403A</Color>
    <Color x:Key="SurfaceHoverColor">#5C514A</Color>
    
    <Color x:Key="PrimaryAccentColor">#F2CDCD</Color>
    <Color x:Key="PrimaryAccentHoverColor">#F5E0DC</Color>
    <Color x:Key="PrimaryAccentMutedColor">#5C514A</Color>
    <Color x:Key="PrimaryAccentGlowColor">#F5E0DC</Color>
    
    <Color x:Key="SuccessColor">#A6E3A1</Color>
    <Color x:Key="WarningColor">#F9E2AF</Color>
    <Color x:Key="ErrorColor">#F38BA8</Color>
    
    <Color x:Key="TextColor">#F5E0DC</Color>
    <Color x:Key="MutedTextColor">#E6C3B5</Color>
    <Color x:Key="DimTextColor">#A69285</Color>
    
    <Color x:Key="BorderColor">#4A403A</Color>

    <!-- ═══ Solid Brushes ═══ -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHover" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryAccentMuted" Color="{StaticResource PrimaryAccentMutedColor}" />
    <SolidColorBrush x:Key="PrimaryAccentGlow" Color="{StaticResource PrimaryAccentGlowColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DimText" Color="{StaticResource DimTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource SurfaceBaseColor}" />

    <!-- ═══ Theme Decoration (Coffee Beans) ═══ -->
    <DrawingBrush x:Key="ThemeTopBarDecoration" Stretch="Uniform" TileMode="Tile" Viewport="0,0,120,120" ViewportUnits="Absolute" Opacity="0.15">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryAccent}" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <!-- Coffee Bean Path -->
                    <PathGeometry Figures="M40,50 A20,30 45 0,0 80,90 A20,30 45 0,0 40,50 Z M45,65 Q60,70 75,75 M70,20 A15,20 -45 0,0 30,30 A15,20 -45 0,0 70,20 Z M40,25 Q45,35 55,35" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
