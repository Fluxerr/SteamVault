<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Color Palette — Dracula ═══ -->
    <Color x:Key="WindowBackgroundColor">#282A36</Color>
    <Color x:Key="SidebarBackgroundColor">#21222C</Color>
    <Color x:Key="SurfaceBaseColor">#343746</Color>
    <Color x:Key="SurfaceRaisedColor">#44475A</Color>
    <Color x:Key="SurfaceHoverColor">#515470</Color>
    
    <Color x:Key="PrimaryAccentColor">#FF5555</Color>
    <Color x:Key="PrimaryAccentHoverColor">#FF6E6E</Color>
    <Color x:Key="PrimaryAccentMutedColor">#521D1D</Color>
    <Color x:Key="PrimaryAccentGlowColor">#FF79C6</Color>
    
    <Color x:Key="SuccessColor">#50FA7B</Color>
    <Color x:Key="WarningColor">#F1FA8C</Color>
    <Color x:Key="ErrorColor">#FF5555</Color>
    
    <Color x:Key="TextColor">#F8F8F2</Color>
    <Color x:Key="MutedTextColor">#CCC9E7</Color>
    <Color x:Key="DimTextColor">#6272A4</Color>
    
    <Color x:Key="BorderColor">#44475A</Color>

    <!-- ═══ Solid Brushes ═══ -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHover" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryAccentMuted" Color="{StaticResource PrimaryAccentMutedColor}" />
    <SolidColorBrush x:Key="PrimaryAccentGlow" Color="{StaticResource PrimaryAccentGlowColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DimText" Color="{StaticResource DimTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource SurfaceBaseColor}" />

    <!-- ═══ Theme Decoration (Bats / Drops) ═══ -->
    <DrawingBrush x:Key="ThemeTopBarDecoration" Stretch="Uniform" TileMode="Tile" Viewport="0,0,140,140" ViewportUnits="Absolute" Opacity="0.15">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryAccent}" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <!-- Bat / Fangs Path -->
                    <PathGeometry Figures="M70,40 Q60,30 40,30 Q50,45 30,50 Q45,60 70,80 Q95,60 110,50 Q90,45 100,30 Q80,30 70,40 M65,80 L65,95 L70,90 L75,95 L75,80" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
