<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Color Palette — Midnight Blue ═══ -->
    <Color x:Key="WindowBackgroundColor">#0A0E17</Color>
    <Color x:Key="SidebarBackgroundColor">#0D121D</Color>
    <Color x:Key="SurfaceBaseColor">#121825</Color>
    <Color x:Key="SurfaceRaisedColor">#1A2234</Color>
    <Color x:Key="SurfaceHoverColor">#222C42</Color>
    
    <Color x:Key="PrimaryAccentColor">#3B82F6</Color>
    <Color x:Key="PrimaryAccentHoverColor">#60A5FA</Color>
    <Color x:Key="PrimaryAccentMutedColor">#1E3A8A</Color>
    <Color x:Key="PrimaryAccentGlowColor">#93C5FD</Color>
    
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    
    <Color x:Key="TextColor">#F1F5F9</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>
    <Color x:Key="DimTextColor">#64748B</Color>
    
    <Color x:Key="BorderColor">#1E293B</Color>

    <!-- ═══ Solid Brushes (must override Dark.xaml brushes for themes to apply) ═══ -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHover" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryAccentMuted" Color="{StaticResource PrimaryAccentMutedColor}" />
    <SolidColorBrush x:Key="PrimaryAccentGlow" Color="{StaticResource PrimaryAccentGlowColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DimText" Color="{StaticResource DimTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource SurfaceBaseColor}" />
</ResourceDictionary>