<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Color Palette — Nordic Frost (Light Arctic Snow) ═══ -->
    <Color x:Key="WindowBackgroundColor">#F3EBE1</Color>
    <Color x:Key="SidebarBackgroundColor">#EAE0D4</Color>
    <Color x:Key="SurfaceBaseColor">#DFD4C7</Color>
    <Color x:Key="SurfaceRaisedColor">#D4C7B8</Color>
    <Color x:Key="SurfaceHoverColor">#C6B7A6</Color>
    
    <Color x:Key="PrimaryAccentColor">#5E81AC</Color>
    <Color x:Key="PrimaryAccentHoverColor">#81A1C1</Color>
    <Color x:Key="PrimaryAccentMutedColor">#88C0D0</Color>
    <Color x:Key="PrimaryAccentGlowColor">#8FBCBB</Color>
    
    <Color x:Key="SuccessColor">#A3BE8C</Color>
    <Color x:Key="WarningColor">#EBCB8B</Color>
    <Color x:Key="ErrorColor">#BF616A</Color>
    
    <Color x:Key="TextColor">#2E3440</Color>
    <Color x:Key="MutedTextColor">#3B4252</Color>
    <Color x:Key="DimTextColor">#4C566A</Color>
    
    <Color x:Key="BorderColor">#D4C7B8</Color>

    <!-- ═══ Solid Brushes ═══ -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHover" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryAccentMuted" Color="{StaticResource PrimaryAccentMutedColor}" />
    <SolidColorBrush x:Key="PrimaryAccentGlow" Color="{StaticResource PrimaryAccentGlowColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DimText" Color="{StaticResource DimTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource SurfaceBaseColor}" />

    <!-- ═══ Theme Decoration (Nordic Snowflakes) ═══ -->
    <DrawingBrush x:Key="ThemeTopBarDecoration" Stretch="Uniform" TileMode="Tile" Viewport="0,0,120,120" ViewportUnits="Absolute" Opacity="0.15">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryAccent}" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <!-- Snowflake Path -->
                    <PathGeometry Figures="M60,20 L60,100 M20,60 L100,60 M32,32 L88,88 M32,88 L88,32 M50,30 L60,20 L70,30 M50,90 L60,100 L70,90 M30,50 L20,60 L30,70 M90,50 L100,60 L90,70 M45,45 L60,35 L75,45 L85,60 L75,75 L60,85 L45,75 L35,60 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
