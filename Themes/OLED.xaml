<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Color Palette — AMOLED Black ═══ -->
    <Color x:Key="WindowBackgroundColor">#000000</Color>
    <Color x:Key="SidebarBackgroundColor">#020202</Color>
    <Color x:Key="SurfaceBaseColor">#0A0A0A</Color>
    <Color x:Key="SurfaceRaisedColor">#141414</Color>
    <Color x:Key="SurfaceHoverColor">#1A1A1A</Color>
    
    <Color x:Key="PrimaryAccentColor">#7C5CFC</Color>
    <Color x:Key="PrimaryAccentHoverColor">#9B82FD</Color>
    <Color x:Key="PrimaryAccentMutedColor">#3D2E7A</Color>
    <Color x:Key="PrimaryAccentGlowColor">#A78BFA</Color>
    
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    
    <Color x:Key="TextColor">#EDEDEF</Color>
    <Color x:Key="MutedTextColor">#9E9EA8</Color>
    <Color x:Key="DimTextColor">#5C5C66</Color>
    
    <Color x:Key="BorderColor">#1A1A1A</Color>

    <!-- ═══ Solid Brushes (must override Dark.xaml brushes for themes to apply) ═══ -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHover" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryAccentMuted" Color="{StaticResource PrimaryAccentMutedColor}" />
    <SolidColorBrush x:Key="PrimaryAccentGlow" Color="{StaticResource PrimaryAccentGlowColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DimText" Color="{StaticResource DimTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource SurfaceBaseColor}" />

    <!-- ═══ Theme Decoration (Geometric Circuit) ═══ -->
    <DrawingBrush x:Key="ThemeTopBarDecoration" Stretch="Uniform" TileMode="Tile" Viewport="0,0,120,120" ViewportUnits="Absolute" Opacity="0.1">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryAccent}" Thickness="2" StartLineCap="Square" EndLineCap="Square" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <!-- Circuit Path -->
                    <PathGeometry Figures="M10,60 L40,60 L50,40 L90,40 M60,100 L60,80 L80,60 L110,60 M20,20 L40,40 M80,20 L100,40 M70,60 L70,70 L90,90 M40,60 A5,5 0 1,1 40,60.1 M90,40 A5,5 0 1,1 90,40.1 M80,60 A5,5 0 1,1 80,60.1 M70,70 A5,5 0 1,1 70,70.1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
