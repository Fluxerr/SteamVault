<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Color Palette — Rosé Pine ═══ -->
    <Color x:Key="WindowBackgroundColor">#191724</Color>
    <Color x:Key="SidebarBackgroundColor">#121019</Color>
    <Color x:Key="SurfaceBaseColor">#1F1D2E</Color>
    <Color x:Key="SurfaceRaisedColor">#26233A</Color>
    <Color x:Key="SurfaceHoverColor">#312F48</Color>
    
    <Color x:Key="PrimaryAccentColor">#C4A7E7</Color>
    <Color x:Key="PrimaryAccentHoverColor">#D5C1F0</Color>
    <Color x:Key="PrimaryAccentMutedColor">#3B2F52</Color>
    <Color x:Key="PrimaryAccentGlowColor">#EBBCBA</Color>
    
    <Color x:Key="SuccessColor">#9CCFD8</Color>
    <Color x:Key="WarningColor">#F6C177</Color>
    <Color x:Key="ErrorColor">#EB6F92</Color>
    
    <Color x:Key="TextColor">#E0DEF4</Color>
    <Color x:Key="MutedTextColor">#908CAA</Color>
    <Color x:Key="DimTextColor">#6E6A86</Color>
    
    <Color x:Key="BorderColor">#26233A</Color>

    <!-- ═══ Solid Brushes ═══ -->
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    
    <SolidColorBrush x:Key="PrimaryAccent" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryAccentHover" Color="{StaticResource PrimaryAccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryAccentMuted" Color="{StaticResource PrimaryAccentMutedColor}" />
    <SolidColorBrush x:Key="PrimaryAccentGlow" Color="{StaticResource PrimaryAccentGlowColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedText" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DimText" Color="{StaticResource DimTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource SurfaceBaseColor}" />

    <!-- ═══ Theme Decoration (Pine Needles) ═══ -->
    <DrawingBrush x:Key="ThemeTopBarDecoration" Stretch="Uniform" TileMode="Tile" Viewport="0,0,120,120" ViewportUnits="Absolute" Opacity="0.15">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource PrimaryAccent}" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <!-- Pine branch Path -->
                    <PathGeometry Figures="M20,100 L100,20 M40,80 L30,60 M50,70 L40,45 M65,55 L55,30 M75,45 L70,20 M40,80 L60,90 M50,70 L75,80 M65,55 L90,65 M75,45 L100,50" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
