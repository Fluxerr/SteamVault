<UserControl x:Class="SteamVault.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SteamVault.ViewModels"
             xmlns:converters="clr-namespace:SteamVault.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="860"
             Loaded="DashboardView_Loaded">
    <UserControl.Resources>
        <converters:InvertibleBoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Spinning animation for processing indicator -->
        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.2"/>
        </Storyboard>

        <!-- Pulse animation for drag-over glow -->
        <Storyboard x:Key="DragOverPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,40,48,40">
            <!-- Header -->
            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard" Style="{DynamicResource TitleText}"/>
                    <TextBlock Text="Search Steam, generate Lua configs, and install through Steam from one focused workspace." 
                               Style="{DynamicResource SubtitleText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding DismissMultiImportCommand}" 
                            Style="{DynamicResource GhostButton}" Padding="12,8"
                            Visibility="{Binding IsMultiImporting, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Top" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/>
                            <TextBlock Text="Back" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ResetDashboardCommand}" 
                            Style="{DynamicResource GhostButton}" Padding="12,8"
                            Visibility="{Binding HasGameInfo, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ MULTI-GAME IMPORT RESULTS ═══ -->
            <StackPanel Visibility="{Binding IsMultiImporting, Converter={StaticResource BoolToVis}}" Margin="0,0,0,24">
                <!-- Import Header Card -->
                <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Margin="0,0,0,24" Padding="16" ClipToBounds="True">
                    <Grid>
                        <!-- Batch Import Watermark -->
                        <Rectangle Fill="{DynamicResource ThemeTopBarDecoration}" Opacity="0.15" IsHitTestVisible="False" 
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Width="300" Height="300" Margin="0,-50,-50,-50">
                            <Rectangle.OpacityMask>
                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="Black" Offset="0.2"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" 
                                    Background="{DynamicResource PrimaryAccentMuted}" Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                           FontSize="22" Foreground="{DynamicResource PrimaryAccent}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Batch Import" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MultiImportSummary}" FontSize="13" Foreground="{DynamicResource MutedText}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Done" Command="{Binding DismissMultiImportCommand}"
                                    Visibility="{Binding MultiImportComplete, Converter={StaticResource BoolToVis}}"
                                    Padding="24,10" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Games Grid -->
                <ItemsControl ItemsSource="{Binding ImportedGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ImportCard" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" 
                                    BorderThickness="0"
                                    Padding="0" Margin="0,0,12,12" Width="340" ClipToBounds="True"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" Y="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Game Banner -->
                                    <Grid Grid.Row="0">
                                        <Border Background="{DynamicResource SurfaceHover}"/>
                                        <Image x:Name="CardImage" Source="{Binding HeaderImageUrl}" Stretch="UniformToFill" 
                                               RenderTransformOrigin="0.5,0.5" Style="{DynamicResource FadeInImage}">
                                            <Image.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Image.RenderTransform>
                                        </Image>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="#CC000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        
                                        <!-- Status Overlay -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                CornerRadius="6" Padding="8,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#60000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                            <Setter Property="Background" Value="#4034D399"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Background" Value="#40F87171"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Game Info -->
                                    <StackPanel Grid.Row="1" Margin="16,12,16,16">
                                        <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="Bold" 
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource SurfaceHover}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding AppId}" Style="{DynamicResource MonoText}" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                                            </Border>
                                            <TextBlock Text="{Binding ManifestText}" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Complete">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ImportCard" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                 From="0.95" To="1.0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ImportCard" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                 From="0.95" To="1.0" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <Trigger SourceName="ImportCard" Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ImportCard" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                                 To="-3" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="CardImage" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                 To="1.08" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="CardImage" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                 To="1.08" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ImportCard" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                                                 To="0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="CardImage" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" 
                                                                 To="1.0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="CardImage" 
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" 
                                                                 To="1.0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Search Area (hidden during multi-import) -->
            <Grid Margin="0,0,0,16"
                  Visibility="{Binding IsMultiImporting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Opacity="0.8">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" Opacity="0.1" ShadowDepth="4"/>
                        </Border.Effect>
                    </Border>
                    <TextBox x:Name="SearchTextBox" Text="{Binding AppIdInput, UpdateSourceTrigger=PropertyChanged}" 
                             Height="64" FontSize="18" VerticalContentAlignment="Center"
                             Padding="56,0,16,0" Tag="Search by game name or App ID..."
                             Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding DownloadCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding SelectSearchResultCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                               FontSize="20" Foreground="{DynamicResource PrimaryAccent}" 
                               VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>

                    <TextBlock Text="Scanning..." FontSize="12" HorizontalAlignment="Right" 
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource PrimaryAccent}"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>

                    <!-- Search History Popup -->
                    <Popup PlacementTarget="{Binding ElementName=SearchTextBox}"
                           Placement="Bottom" StaysOpen="True"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           HorizontalOffset="0" Width="{Binding ActualWidth, ElementName=SearchTextBox}">
                        <Popup.Style>
                            <Style TargetType="Popup">
                                <Setter Property="IsOpen" Value="False"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="True"/>
                                            <Condition Binding="{Binding Text.Length, ElementName=SearchTextBox}" Value="0"/>
                                            <Condition Binding="{Binding SearchHistoryList.Count, Converter={StaticResource MathConverter}, ConverterParameter='>0'}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsOpen" Value="True"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Popup.Style>
                        <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SurfaceRaised}" Margin="4,4,4,8"
                                Visibility="{Binding SearchHistoryList.Count, Converter={StaticResource MathConverter}, ConverterParameter='>0', FallbackValue=Collapsed}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.3" ShadowDepth="8"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Recent Searches" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" Margin="16,12,16,4"/>
                                <ItemsControl ItemsSource="{Binding SearchHistoryList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="HistoryItem" Background="Transparent" Padding="16,10" Cursor="Hand" MouseLeftButtonDown="HistoryItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource MutedText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Text}"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="HistoryItem" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HistoryItem" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Search Results Popup (overlays instead of pushing content) -->
                    <Popup IsOpen="{Binding ShowSearchResults}" 
                           PlacementTarget="{Binding ElementName=SearchTextBox}"
                           Placement="Bottom" StaysOpen="True"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           HorizontalOffset="0" Width="{Binding ActualWidth, ElementName=SearchTextBox}">
                        <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SurfaceRaised}"
                                Margin="4,4,4,8">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.3" ShadowDepth="8"/>
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding SearchResults}" MaxHeight="320">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ResultItem" Background="Transparent" 
                                                Padding="16,12" Cursor="Hand"
                                                MouseLeftButtonDown="SearchResult_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Width="72" Height="32">
                                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                           VerticalAlignment="Center" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" Margin="12,0"/>
                                                <Border Grid.Column="2" Background="{DynamicResource SurfaceHover}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppId}" Style="{DynamicResource MonoText}" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="ResultItem" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ResultItem" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>

                <Button Grid.Column="1" Content="Download Config" Width="180" Height="56" Margin="16,0,0,0" 
                        Command="{Binding DownloadCommand}" FontSize="15"/>
            </Grid>

            <!-- Progress & Error (Shown when Game Card is hidden) -->
            <StackPanel Margin="0,0,0,24"
                        Visibility="{Binding IsMultiImporting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MutedText}"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding Progress}" Maximum="100"/>
                </StackPanel>

                <Border CornerRadius="8" Padding="16,12" Background="#EF444415"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource ErrorBrush}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ErrorBrush}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Game Result Card -->
            <Border Style="{DynamicResource SurfaceCard}" Margin="0,0,0,24" Padding="0" ClipToBounds="True"
                    Visibility="{Binding HasGameInfo, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Banner -->
                    <Grid Grid.Row="0">
                        <Border Background="{DynamicResource SurfaceRaised}"/>
                        <Image Source="{Binding GameImage}" Stretch="UniformToFill" Style="{DynamicResource FadeInImage}"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33000000" Offset="0"/>
                                    <GradientStop Color="#F21A1A1F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,24">
                            <TextBlock Text="{Binding GameName}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Content Area -->
                    <Grid Grid.Row="1" Margin="40,24,40,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Info -->
                        <StackPanel Grid.Column="0" Margin="0,0,48,0">
                            <!-- Multiplayer Warning -->
                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,24" Background="#1A2B200A" Visibility="{Binding ShowMultiplayerWarning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="14"/>
                                    <TextBlock Text="Singleplayer only - multiplayer features must be added in the 'Multiplayer' tab."
                                               Foreground="{DynamicResource WarningBrush}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,0,0,24">
                                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding AppIdInput, StringFormat='ID: {0}'}" Style="{DynamicResource MonoText}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding GameType}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding GameReleaseDate}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8"
                                        Visibility="{Binding EstimatedSize, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding EstimatedSize, StringFormat='Size {0}'}"
                                               FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding GameDescription}" TextWrapping="Wrap" FontSize="14" LineHeight="24"
                                       Foreground="{DynamicResource MutedText}" Margin="0,0,0,24"/>

                            <!-- System Compatibility Badge -->
                            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Background="{DynamicResource SurfaceHover}"
                                    Visibility="{Binding HasCompatibilityData, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{Binding CompatibilityBadgeColor}" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompatibilityRating, StringFormat='COMPATIBILITY: {0}'}" 
                                                       Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource MutedText}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                        <TextBlock Text="{Binding CompatibilityText}" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Requirements vs Your System Comparison Table -->
                                    <Border Background="{DynamicResource SurfaceBase}" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="1"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Table Header -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SPEC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DimText}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="GAME REQUIREMENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="YOUR SYSTEM SPECS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>

                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceHover}" Margin="0,6,0,8"/>

                                            <!-- RAM Row -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,6">
                                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="RAM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GameReqRam}" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,2,10,6" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding UserRamText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Top" Margin="0,2,0,6" TextWrapping="Wrap"/>

                                            <!-- CPU Row -->
                                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,6">
                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameReqCpu}" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,2,10,6" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding UserCpuName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Top" Margin="0,2,0,6" TextWrapping="Wrap"/>

                                            <!-- GPU Row -->
                                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="GPU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GameReqGpu}" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,2,10,0" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding UserGpuName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Top" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- HowLongToBeat Stats Grid -->
                            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,24" Background="{DynamicResource SurfaceHover}"
                                    Visibility="{Binding HasHltbData, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13"/>
                                        <TextBlock Text="HOW LONG TO BEAT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                                    </StackPanel>
                                    <WrapPanel>
                                        <Border Background="{DynamicResource SurfaceBase}" CornerRadius="6" Padding="10,6" Margin="0,0,10,6">
                                            <StackPanel>
                                                <TextBlock Text="Main Story" FontSize="10" Foreground="{DynamicResource DimText}"/>
                                                <TextBlock Text="{Binding HltbMainStory}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Foreground}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceBase}" CornerRadius="6" Padding="10,6" Margin="0,0,10,6">
                                            <StackPanel>
                                                <TextBlock Text="Main + Extra" FontSize="10" Foreground="{DynamicResource DimText}"/>
                                                <TextBlock Text="{Binding HltbMainExtra}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Foreground}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource SurfaceBase}" CornerRadius="6" Padding="10,6" Margin="0,0,10,6">
                                            <StackPanel>
                                                <TextBlock Text="Completionist" FontSize="10" Foreground="{DynamicResource DimText}"/>
                                                <TextBlock Text="{Binding HltbCompletionist}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Foreground}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stats -->
                            <StackPanel Visibility="{Binding ShowSteamDbStats, Converter={StaticResource BoolToVis}}" Orientation="Horizontal" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding PlayerCountText, Converter={StaticResource BoolToVis}}" Margin="0,0,32,0">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PlayerCountText}" FontSize="13" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding ReviewScoreText, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource DimText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ReviewScoreText}" FontSize="13" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Border CornerRadius="8" Padding="16,12" Background="#1A34D399" Margin="0,0,0,12" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE93E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16"/>
                                    <TextBlock Text="{Binding ResultSummary}" Foreground="{DynamicResource SuccessBrush}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Success Text -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Lua generated successfully - ready to play" Foreground="{DynamicResource SuccessBrush}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Actions -->
                        <StackPanel Grid.Column="1">
                            <Button Content="Install via Steam" Command="{Binding InstallGameCommand}" Margin="0,0,0,16"/>
                            <Button Content="Open Lua Folder" Command="{Binding OpenLuaFolderCommand}" Style="{DynamicResource DrawOutlineGhostButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ FEATURED CONFIGS + QUICK ACTIONS ═══ -->
            <Grid Margin="0,0,0,16"
                  Visibility="{Binding HasGameInfo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMultiImporting}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- RECENT ACTIVITY (left column) -->
                <StackPanel Grid.Column="0" Margin="0,0,48,0">
                    <!-- Header Row -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recent Activity" Style="{DynamicResource SectionHeader}" Margin="0"/>
                        <Button Grid.Column="1" Command="{Binding ViewAllCommand}" Style="{DynamicResource GhostButton}"
                                Padding="8,4" BorderThickness="0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="View All" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="→" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Timeline Dot and Line -->
                                    <Grid Grid.Column="0" Width="32">
                                        <Rectangle Width="2" Fill="{DynamicResource BorderBrush}" Margin="0,24,0,-16" HorizontalAlignment="Center"/>
                                        <Ellipse Width="12" Height="12" Fill="{DynamicResource PrimaryAccent}" Stroke="{DynamicResource SurfaceBackground}" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    </Grid>
                                    
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="16,12" Margin="12,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DownloadDate, StringFormat='{}{0:MMM dd, yyyy}'}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No recent activity to show." Foreground="{DynamicResource MutedText}" FontStyle="Italic" 
                               Visibility="{Binding RecentActivity.Count, Converter={StaticResource MathConverter}, ConverterParameter='==0', FallbackValue=Collapsed}"/>
                </StackPanel>

                <!-- QUICK ACTIONS (right column) -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="Import Configs" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>

                    <!-- ═══ ENHANCED DROP ZONE (VISIBLE SCALE + VECTOR TEXT) ═══ -->
                    <Grid x:Name="DropZoneContainer" Margin="0,0,0,24" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="DropZoneScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- Shadow Layer -->
                        <Border x:Name="DropZoneShadow" CornerRadius="16" MinHeight="160">
                            <Border.Effect>
                                <DropShadowEffect x:Name="DropZoneGlow" Color="{DynamicResource PrimaryAccentColor}" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>

                        <!-- Content & Drag Target Layer (No Bitmap Caching) -->
                        <Border x:Name="DropZoneBorder" CornerRadius="16" 
                                Padding="24,32" AllowDrop="True" 
                                DragOver="DropArea_DragOver" Drop="DropArea_Drop"
                                DragEnter="DropArea_DragEnter" DragLeave="DropArea_DragLeave"
                                Cursor="Hand" MinHeight="160"
                                BorderThickness="2"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextHintingMode="Fixed">
                            <Border.Background>
                                <SolidColorBrush x:Name="DropZoneBg" Color="{DynamicResource SurfaceRaisedColor}"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="DropZoneBorderBrush" Color="{DynamicResource BorderColor}"/>
                            </Border.BorderBrush>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock x:Name="DropZoneIcon" Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" 
                                           Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center" Margin="0,0,0,12"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="DropZoneIconTranslate" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="DropZoneTitle" Text="Drop Configs Here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text=".lua or .zip files supported" FontSize="12" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <TextBlock Text="Quick Actions" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="QALuaFolder" Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="12,10"
                                BorderBrush="{DynamicResource SurfaceHover}" BorderThickness="1"
                                Cursor="Hand" Margin="0,0,4,8" Grid.Column="0">
                            <Button Command="{Binding OpenLuaFolderQuickCommand}" Style="{DynamicResource GhostButton}"
                                    Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lua Folder" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border x:Name="QAUpdateAll" Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="12,10"
                                BorderBrush="{DynamicResource SurfaceHover}" BorderThickness="1"
                                Opacity="0.6" Margin="4,0,0,8" Grid.Column="1" ToolTip="Config updates are currently unavailable.">
                            <Button Command="{Binding UpdateAllGamesCommand}" IsEnabled="False" Style="{DynamicResource GhostButton}"
                                    Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Update All (Disabled)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>

                    <Border x:Name="QAAutoUpdate" Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="16,14"
                            BorderBrush="{DynamicResource SurfaceHover}" BorderThickness="1"
                            Opacity="0.6" Margin="0,0,0,8" ToolTip="Auto-updater is temporarily disabled.">
                        <Button Command="{Binding ToggleAutoUpdateCommand}" IsEnabled="False" Style="{DynamicResource GhostButton}"
                                Padding="0" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE785;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{DynamicResource MutedText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Toggle Auto Updater" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding AutoUpdateText}" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
