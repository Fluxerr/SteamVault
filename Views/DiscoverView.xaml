<UserControl x:Class="SteamVault.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SteamVault.ViewModels"
             xmlns:converters="clr-namespace:SteamVault.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:DiscoverViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="860">
    <UserControl.Resources>
        <converters:InvertibleBoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EqualityConverter x:Key="EqualityConverter" />
        
        <DataTemplate x:Key="DiscoverCardTemplate">
            <Border x:Name="DiscoverCard" Margin="6" Background="{DynamicResource SurfaceBase}" BorderThickness="0" CornerRadius="12" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="DiscoverCard_Click" RenderTransformOrigin="0.5,0.5" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                <Border.ToolTip>
                    <ToolTip Background="{DynamicResource SurfaceRaised}" BorderThickness="0" HasDropShadow="True">
                        <StackPanel Margin="8">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PriceFormatted}" FontSize="13" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource SurfaceRaised}" Height="120"/>
                            <Image x:Name="CardImage" Source="{Binding ImageUrl}" Stretch="UniformToFill" Height="120" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource FadeInImage}">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>
                            
                            <!-- Gradient scrim -->
                            <Border VerticalAlignment="Bottom" Height="50">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#CC1A1A1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <StackPanel Grid.Row="1" Margin="14,10,14,14">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <Border x:Name="IdPill" Background="{DynamicResource SurfaceHover}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Opacity="0">
                            <TextBlock Text="{Binding AppId, StringFormat='ID: {0}'}" Style="{DynamicResource MonoText}" FontSize="11" Foreground="{DynamicResource DimText}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="DiscoverCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DiscoverCard" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DiscoverCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="IdPill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DiscoverCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="IdPill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="48,40,48,40">
            <!-- ═══ BROWSE GRID ═══ -->
            <StackPanel Visibility="{Binding ShowBrowseGrid, Converter={StaticResource BoolToVis}}">
                <!-- Header -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Discover" Style="{DynamicResource TitleText}"/>
                    <TextBlock Text="Browse trending games, top sellers, and new releases from Steam." Style="{DynamicResource SubtitleText}"/>
                </StackPanel>

                <!-- Unified Discover Top Bar Container -->
                <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Margin="0,0,0,16" ClipToBounds="True">
                    <Grid>
                        <!-- Theme Decoration Background -->
                        <Rectangle Fill="{DynamicResource ThemeTopBarDecoration}" IsHitTestVisible="False"/>
                        
                        <Grid Margin="10,8">
                            <!-- Left Controls: Search, View Mode, Category Segmented Control -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="180" Height="36" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Tag="Search Discover..." Margin="0,0,10,0"/>

                            <!-- Category Segmented Control with Sliding Background Pill -->
                            <Border Background="{DynamicResource SurfaceBase}" CornerRadius="8" Padding="3" Margin="0,0,10,0" Height="36">
                                <Grid>
                                    <!-- Sliding Indicator Pill -->
                                    <Border x:Name="DiscoverCategoryIndicator" Width="85" Height="30" Background="{DynamicResource SurfaceRaised}" CornerRadius="6" HorizontalAlignment="Left">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.2"/>
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="DiscoverCategoryTranslate" X="0"/>
                                        </Border.RenderTransform>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="DiscoverCategoryGroup" Content="Trending" Width="85" IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter='Trending'}" Command="{Binding SetCategoryCommand}" CommandParameter="Trending" Style="{StaticResource SlidingToggleTextStyle}">
                                            <RadioButton.Triggers>
                                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DiscoverCategoryTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="DiscoverCategoryIndicator" Storyboard.TargetProperty="Width" To="85" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </RadioButton.Triggers>
                                        </RadioButton>
                                        <RadioButton GroupName="DiscoverCategoryGroup" Content="Top Sellers" Width="100" IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter='Top Sellers'}" Command="{Binding SetCategoryCommand}" CommandParameter="Top Sellers" Style="{StaticResource SlidingToggleTextStyle}">
                                            <RadioButton.Triggers>
                                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DiscoverCategoryTranslate" Storyboard.TargetProperty="X" To="85" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="DiscoverCategoryIndicator" Storyboard.TargetProperty="Width" To="100" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </RadioButton.Triggers>
                                        </RadioButton>
                                        <RadioButton GroupName="DiscoverCategoryGroup" Content="New Releases" Width="110" IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter='New Releases'}" Command="{Binding SetCategoryCommand}" CommandParameter="New Releases" Style="{StaticResource SlidingToggleTextStyle}">
                                            <RadioButton.Triggers>
                                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DiscoverCategoryTranslate" Storyboard.TargetProperty="X" To="185" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="DiscoverCategoryIndicator" Storyboard.TargetProperty="Width" To="110" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </RadioButton.Triggers>
                                        </RadioButton>
                                        <RadioButton GroupName="DiscoverCategoryGroup" Content="Specials" Width="85" IsChecked="{Binding SelectedCategory, Converter={StaticResource EqualityConverter}, ConverterParameter='Specials'}" Command="{Binding SetCategoryCommand}" CommandParameter="Specials" Style="{StaticResource SlidingToggleTextStyle}">
                                            <RadioButton.Triggers>
                                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DiscoverCategoryTranslate" Storyboard.TargetProperty="X" To="295" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="DiscoverCategoryIndicator" Storyboard.TargetProperty="Width" To="85" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </RadioButton.Triggers>
                                        </RadioButton>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Right Controls: Platform & Refresh -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Platform Segmented Control -->
                            <Border Background="{DynamicResource SurfaceBase}" CornerRadius="8" Padding="3" Margin="0,0,10,0" Height="36">
                                <Grid>
                                    <!-- Sliding Indicator Pill -->
                                    <Border x:Name="PlatformIndicator" Width="36" Height="30" Background="{DynamicResource SurfaceRaised}" CornerRadius="6" HorizontalAlignment="Left">
                                        <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.2"/></Border.Effect>
                                        <Border.RenderTransform><TranslateTransform x:Name="PlatformTranslate" X="0"/></Border.RenderTransform>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="PlatformGroup" IsChecked="True" Style="{StaticResource SlidingToggleIconStyle}" ToolTip="Windows PC">
                                            <RadioButton.Triggers>
                                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="PlatformTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                                                </EventTrigger>
                                            </RadioButton.Triggers>
                                            <!-- Windows Icon Path -->
                                            <Path Data="M0,2 L6,1 L6,7 L0,7 Z M7,0.8 L14,0 L14,7 L7,7 Z M0,8 L6,8 L6,14 L0,13 Z M7,8 L14,8 L14,15 L7,14.2 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform"/>
                                        </RadioButton>
                                        <RadioButton GroupName="PlatformGroup" Style="{StaticResource SlidingToggleIconStyle}" ToolTip="Steam Deck">
                                            <RadioButton.Triggers>
                                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard><DoubleAnimation Storyboard.TargetName="PlatformTranslate" Storyboard.TargetProperty="X" To="36" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                                                </EventTrigger>
                                            </RadioButton.Triggers>
                                            <!-- Gamepad Icon (Steam Deck) -->
                                            <TextBlock Text="&#xE909;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button Command="{Binding RefreshCommand}" Style="{DynamicResource DrawOutlineGhostButton}" Padding="12,6" Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Border>

                <!-- Status & Loading State Container -->
                <Grid>
                    <!-- Loading Watermark -->
                    <Rectangle Fill="{DynamicResource ThemeTopBarDecoration}" Opacity="0.08" IsHitTestVisible="False" 
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                               Width="450" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <Rectangle.OpacityMask>
                            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="Black" Offset="0.2"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DimText}" FontSize="13" Margin="0,0,0,16"/>

                        <!-- Loading State -->
                        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Margin="0,48,0,0">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Loading games from Steam..." Foreground="{DynamicResource MutedText}" FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Paginated Grid -->
                <StackPanel Margin="0,0,0,32">
                    <ItemsControl ItemsSource="{Binding FilteredGames}" ItemTemplate="{StaticResource DiscoverCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Pagination Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="{Binding FilteredGames.Count, Converter={StaticResource MathConverter}, ConverterParameter='>0', FallbackValue=Collapsed}">
                    <Button Command="{Binding PrevPageCommand}" Style="{DynamicResource GhostButton}" Width="40" Height="40" Padding="0">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                    <TextBlock FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="24,0">
                        <Run Text="Page "/>
                        <Run Text="{Binding CurrentPage}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages}"/>
                    </TextBlock>
                    <Button Command="{Binding NextPageCommand}" Style="{DynamicResource GhostButton}" Width="40" Height="40" Padding="0">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                </StackPanel>

                <!-- Search Results -->
                <StackPanel Margin="0,0,0,32" Visibility="{Binding ShowSearchGrid, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource PrimaryAccent}" Margin="0,0,12,0"/>
                        <TextBlock Text="Search Results" Style="{DynamicResource SectionHeader}" Margin="0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource DiscoverCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- ═══ GAME DETAIL VIEW ═══ -->
            <Border Visibility="{Binding ShowGameDetail, Converter={StaticResource BoolToVis}}" Padding="0" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowGameDetail}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="40,0,0,0" To="0" Duration="0:0:0.35">
                                                <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Banner -->
                    <Grid Grid.Row="0">
                        <Border Background="{DynamicResource SurfaceRaised}"/>
                        <Image Source="{Binding DetailGameImage}" Stretch="UniformToFill" Style="{DynamicResource FadeInImage}"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33000000" Offset="0"/>
                                    <GradientStop Color="#F21A1A1F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,24">
                            <Button Command="{Binding BackToDiscoverCommand}" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Padding="8,4" Margin="-8,0,0,16" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Back to Browse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding DetailGameName}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Content Area -->
                    <Grid Grid.Row="1" Margin="40,24,40,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Info -->
                        <StackPanel Grid.Column="0" Margin="0,0,40,0">
                            <!-- Multiplayer Warning -->
                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,24" Background="#1A2B200A" Visibility="{Binding DetailShowMultiplayerWarning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="14"/>
                                    <TextBlock Text="Singleplayer only - multiplayer features unavailable" Foreground="{DynamicResource WarningBrush}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,0,0,20">
                                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding DetailAppId, StringFormat='ID: {0}'}" Style="{DynamicResource MonoText}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding DetailType}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                </Border>
                                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding DetailReleaseDate}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap" FontSize="14" LineHeight="24" Foreground="{DynamicResource MutedText}" Margin="0,0,0,32"/>

                            <!-- Stats -->
                            <StackPanel Visibility="{Binding DetailHasStats, Converter={StaticResource BoolToVis}}" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DetailPlayerCount}" FontSize="13" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource DimText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DetailReviewScore}" FontSize="13" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Actions -->
                        <StackPanel Grid.Column="1">
                            <!-- Download State -->
                            <Border CornerRadius="12" Padding="20" Margin="0,0,0,24" Background="{DynamicResource SurfaceRaised}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetailStatusMessage}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedText}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailStatusMessage}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Visibility="{Binding IsDownloadComplete, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DetailStatusMessage}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedText}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" Margin="0,0,0,12"/>
                                    
                                    <ProgressBar Value="{Binding DetailProgress}" Maximum="100" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Download Config" Command="{Binding DownloadDetailGameCommand}" Margin="0,0,0,12"/>
                            <Button Content="Install via Steam" Command="{Binding InstallDetailGameCommand}" Style="{DynamicResource GhostButton}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
