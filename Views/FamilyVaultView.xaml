<UserControl x:Class="SteamVault.Views.FamilyVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SteamVault.ViewModels"
             xmlns:converters="clr-namespace:SteamVault.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:FamilyVaultViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:InvertibleBoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:MathConverter x:Key="MathConverter" />

        <DataTemplate x:Key="FamilyGameCardTemplate">
            <Border x:Name="FamilyGameCard" Margin="8" Background="{DynamicResource SurfaceBase}" BorderThickness="0" CornerRadius="16" ClipToBounds="True" Cursor="Hand" RenderTransformOrigin="0.5,0.5" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove from Family Pool" 
                                  Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#FF6B6B"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header Image -->
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource SurfaceRaised}" />
                            <Image x:Name="CardImage" Source="{Binding HeaderImage, TargetNullValue='', FallbackValue=''}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource FadeInImage}">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>
                            
                            <!-- Gradient scrim overlay -->
                            <Border VerticalAlignment="Bottom" Height="60">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#E61A1A1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Delete Button (Top Left of Image) -->
                            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Panel.ZIndex="10"
                                    Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Remove game from Family Vault"
                                    Style="{DynamicResource GhostButton}" Padding="6,4" Background="#EE1A1A1F">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#FF6B6B"/>
                            </Button>
                            
                            <!-- App ID Glassmorphism Pill (Top Right) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#E6111115" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding AppId, StringFormat='{}ID: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" Style="{DynamicResource MonoText}"/>
                            </Border>

                            <!-- Added By Pill (Bottom Left of Image) -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Background="#EE1A1A1F" CornerRadius="6" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AddedBy}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Card Body Content -->
                    <Grid Grid.Row="1" Margin="16,12,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Lua Config Synced" FontSize="12" Foreground="{DynamicResource DimText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Delete game from pool"
                                Style="{DynamicResource GhostButton}" Padding="8">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FF6B6B"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="FamilyGameCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="FamilyGameCard" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FamilyGameCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FamilyGameCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- SINGLE MAIN SCROLLVIEWER (Handles all mouse wheel scrolling without nesting!) -->
    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <StackPanel Margin="48,40,48,40">

            <!-- 1. HEADER TITLE -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Family Vault" Style="{DynamicResource TitleText}"/>
                    <Border Background="#2534D399" CornerRadius="4" Padding="6,2" Margin="12,0,0,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SHARED POOL ACTIVE" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="Share Steam games across your family network. Contributed games automatically generate Lua configs for everyone." 
                           Style="{DynamicResource SubtitleText}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 2. UNIFIED TOP BAR CONTAINER WITH LIVE FUZZY SEARCH -->
            <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Margin="0,0,0,24" ClipToBounds="True">
                <Grid>
                    <Rectangle Fill="{DynamicResource ThemeTopBarDecoration}" IsHitTestVisible="False"/>
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Live Fuzzy Search Box for Games -->
                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid>
                                <Border Background="{DynamicResource SurfaceBase}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid>
                                        <TextBox x:Name="SearchGameTextBox" 
                                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                 Height="40" FontSize="14" VerticalContentAlignment="Center"
                                                 Padding="36,0,16,0" Tag="Search game by name or App ID to add to family pool..."
                                                 Background="Transparent" BorderThickness="0">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding ContributeGameCommand}"/>
                                                <KeyBinding Key="Escape" Command="{Binding SelectSearchResultCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                                   FontSize="16" Foreground="{DynamicResource PrimaryAccent}" 
                                                   VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>

                                        <TextBlock Text="Scanning..." FontSize="12" HorizontalAlignment="Right" 
                                                   VerticalAlignment="Center" Margin="0,0,16,0"
                                                   Foreground="{DynamicResource PrimaryAccent}"
                                                   Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>

                                <!-- Search Results Dropdown Overlay -->
                                <Popup IsOpen="{Binding ShowSearchResults}" 
                                       PlacementTarget="{Binding ElementName=SearchGameTextBox}"
                                       Placement="Bottom" StaysOpen="True"
                                       AllowsTransparency="True" PopupAnimation="Fade"
                                       HorizontalOffset="0" Width="{Binding ActualWidth, ElementName=SearchGameTextBox}">
                                    <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SurfaceRaised}" Margin="0,4,0,8">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.3" ShadowDepth="8"/>
                                        </Border.Effect>
                                        <ItemsControl ItemsSource="{Binding SearchResults}" MaxHeight="320">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="ResultItem" Background="Transparent" Padding="14,10" Cursor="Hand" MouseLeftButtonDown="SearchResult_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Width="56" Height="28">
                                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                                                            <Border Grid.Column="2" Background="{DynamicResource SurfaceHover}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AppId}" Style="{DynamicResource MonoText}" FontSize="11" Foreground="{DynamicResource MutedText}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="ResultItem" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ResultItem" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <!-- Right Controls: Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ContributeGameCommand}" Style="{DynamicResource DrawOutlineButton}" Padding="16,8" Height="40" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Game" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SyncAllCommand}" Style="{DynamicResource DrawOutlineButton}" Padding="16,8" Height="40" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sync All Games" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding RefreshCommand}" Style="{DynamicResource GhostButton}" Padding="12,8" Height="40" ToolTip="Refresh Family Vault">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. REAL-TIME SYNC PROGRESS BANNER (Visible during downloading / syncing) -->
            <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,24"
                    Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SyncProgress, StringFormat='{}{0:F0}%'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>

                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding SyncProgress}" Maximum="100" Height="8" Background="{DynamicResource SurfaceBase}" Foreground="{DynamicResource PrimaryAccent}"/>
                </Grid>
            </Border>

            <!-- 4. INVITE & JOIN FAMILY CARDS (Clear 2-Column Section for Sharing with Friends) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD A: INVITE A FRIEND -->
                <Border Grid.Column="0" CornerRadius="16" Padding="24,20" Margin="0,0,12,0" 
                        Background="{DynamicResource SurfaceBase}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource PrimaryAccentMuted}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Invite to Lobby" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Share your Family Vault lobby code" FontSize="12" Foreground="{DynamicResource DimText}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Click below to copy your Family Lobby Code. Anyone with this code can join your Family Pool and access all shared games!" 
                                   FontSize="13" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16"/>

                        <Button Grid.Row="2" Command="{Binding ExportTokenCommand}" Style="{DynamicResource DrawOutlineButton}" Height="42">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Lobby Code" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- CARD B: JOIN A FRIEND'S FAMILY -->
                <Border Grid.Column="1" CornerRadius="16" Padding="24,20" Margin="12,0,0,0" 
                        Background="{DynamicResource SurfaceBase}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#2034D399" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Join Friend's Lobby" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="Enter a lobby invite code" FontSize="12" Foreground="{DynamicResource DimText}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource SurfaceRaised}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Margin="0,8,0,16">
                            <TextBox Text="{Binding ImportTokenInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="42" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" 
                                     Tag="Paste friend's lobby code here..." Background="Transparent" BorderThickness="0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ImportTokenCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Border>

                        <Button Grid.Row="2" Command="{Binding ImportTokenCommand}" Height="42">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Join Family Lobby" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. LINKED FAMILY MEMBERS ROW -->
            <Border CornerRadius="16" Padding="20,16" Margin="0,0,0,24" 
                    Background="{DynamicResource SurfaceBase}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LINKED FAMILY MEMBERS" Style="{DynamicResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource SurfaceHover}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalMembersCount, StringFormat='{}{0} Members'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DimText}"/>
                            </Border>
                        </StackPanel>

                        <!-- Host Option: Close Family Vault / Disband Lobby -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding CloseFamilyCommand}"
                                Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}"
                                Style="{DynamicResource GhostButton}" Padding="10,4" ToolTip="Disband this Family Vault room and remove all members">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#FF6B6B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Close Family Vault" FontSize="12" FontWeight="SemiBold" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Member Option: Leave Family Vault -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding LeaveFamilyCommand}"
                                Visibility="{Binding IsMember, Converter={StaticResource BoolToVis}}"
                                Style="{DynamicResource GhostButton}" Padding="10,4" ToolTip="Leave this Family Vault and return to your own solo lobby">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#FF6B6B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Leave Family Vault" FontSize="12" FontWeight="SemiBold" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Members Chips Horizontal Wrap -->
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="20" Padding="12,6" Margin="0,0,10,8" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PrimaryAccentMuted}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        <Border Margin="6,0,4,0" Background="#3038BDF8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="HOST" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>
                                        <Button Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding Id}" Width="20" Height="20" Style="{DynamicResource GhostButton}" Padding="0" Margin="4,0,0,0" Cursor="Hand" ToolTip="Remove Member">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource DimText}" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 6. FULL-WIDTH SHARED GAMES GALLERY -->
            <Border CornerRadius="16" Padding="24" 
                    Background="{DynamicResource SurfaceBase}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Section Header -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SHARED GAMES POOL" Style="{DynamicResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource PrimaryAccentMuted}" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalGamesCount, StringFormat='{}{0} Games'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Empty State Placeholder when 0 games are shared -->
                    <StackPanel Visibility="{Binding FamilyGames.Count, Converter={StaticResource MathConverter}, ConverterParameter='==0'}" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimaryAccentMuted}" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Shared Pool is Empty" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Use the search bar above to search for a game and add it to your family network!" 
                                   FontSize="13" Foreground="{DynamicResource DimText}" HorizontalAlignment="Center" MaxWidth="380" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Full-Width 3-Column Games Gallery Grid -->
                    <ItemsControl ItemsSource="{Binding FamilyGames}" ItemTemplate="{StaticResource FamilyGameCardTemplate}"
                                  Visibility="{Binding FamilyGames.Count, Converter={StaticResource MathConverter}, ConverterParameter='>0'}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 7. BOTTOM STATUS BAR -->
            <Border Margin="0,24,0,0" Padding="16,12" Background="{DynamicResource SurfaceBase}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource PrimaryAccent}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
