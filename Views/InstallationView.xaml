<UserControl x:Class="SteamVault.Views.InstallationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SteamVault.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:InvertibleBoolToVisibilityConverter x:Key="InvertBoolConverter"/>
        <converters:InvertibleBoolToVisibilityConverter x:Key="InvertBoolConverter2"/>
    </UserControl.Resources>
    
    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource WindowBackgroundColor}" Offset="0.0"/>
                <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="0.5"/>
                <GradientStop Color="{DynamicResource SidebarBackgroundColor}" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Main Installation Content (hidden when complete) -->
        <Grid Visibility="{Binding ShowInstallContent, Converter={StaticResource InvertBoolConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="600" MaxWidth="800" Margin="48,60,48,60">

                    <!-- Header -->
                    <StackPanel Margin="0,0,0,40" HorizontalAlignment="Center" Style="{DynamicResource FadeInElement}">
                        <TextBlock Text="Welcome to SteamVault" Style="{DynamicResource TitleText}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Border Width="80" Height="4" Background="{DynamicResource PrimaryAccent}" CornerRadius="2" Margin="0,0,0,24" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource PrimaryAccentColor}" BlurRadius="12" Opacity="0.5" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="Set up OpenSteamTool once, then SteamVault can manage your local configurations effortlessly."
                                   Style="{DynamicResource SubtitleText}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
                    </StackPanel>

                    <!-- Glassmorphism Card -->
                    <Border CornerRadius="20" Padding="40" Style="{DynamicResource FadeInElement}" Margin="0,0,0,32">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource SurfaceBaseColor}" Opacity="0.85" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource BorderColor}" Opacity="0.5" />
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.25" ShadowDepth="10"/>
                        </Border.Effect>

                        <StackPanel>
                            <!-- Steam Directory Selection -->
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="Steam Installation Path" Style="{DynamicResource SectionHeader}" FontSize="18"/>
                                <TextBlock Text="Detected from your system. If this is incorrect, browse manually." Foreground="{DynamicResource MutedText}" FontSize="14" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SteamDirectory}" Height="52" VerticalContentAlignment="Center" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono, Consolas, monospace" FontSize="14" IsReadOnly="True" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" Width="52" Height="52" Style="{DynamicResource GhostButton}" IsEnabled="{Binding CanBrowse}">
                                        <TextBlock Text="&#xE8DA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"/>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding StatusIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="{DynamicResource DimText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Features List -->
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="What we're installing" Style="{DynamicResource SectionHeader}" FontSize="18" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- DLLs -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource PrimaryAccentMuted}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Core DLLs" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="OpenSteamTool" FontSize="13" Foreground="{DynamicResource DimText}"/>
                                    </StackPanel>
                                    <!-- Lua -->
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SurfaceRaised}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Lua Scripts" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="Config management" FontSize="13" Foreground="{DynamicResource DimText}"/>
                                    </StackPanel>
                                    <!-- Manifests -->
                                    <StackPanel Grid.Column="2">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SurfaceRaised}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="&#xED43;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Manifest Cache" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="Local updates" FontSize="13" Foreground="{DynamicResource DimText}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Admin Prompt -->
                            <Border Background="#1AFBBF24" CornerRadius="12" Padding="20" Visibility="{Binding ShowAdminPrompt, Converter={StaticResource InvertBoolConverter2}}" Margin="0,0,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource WarningBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Administrator Privileges Required" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="We need permission to create folders inside the Steam directory." FontSize="13" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Restart as Admin" Command="{Binding RetryAsAdminCommand}" Height="40" Padding="16,0" Background="{DynamicResource WarningBrush}" Foreground="#451A03" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Action Area -->
                            <Grid Margin="0,16,0,0">
                                <!-- Installing state -->
                                <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource InvertBoolConverter}}" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressText}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <ProgressBar Value="{Binding ProgressPercent}" Height="6" Width="400" Maximum="100"/>
                                </StackPanel>
                                
                                <!-- Ready state -->
                                <Button Content="Install OpenSteamTool" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Height="54" FontSize="16" Visibility="{Binding IsInstalling, Converter={StaticResource InvertBoolConverter2}, ConverterParameter=invert}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Installation Complete Overlay -->
        <Grid Visibility="{Binding IsComplete, Converter={StaticResource InvertBoolConverter}}">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource WindowBackgroundColor}" Opacity="0.95"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource FadeInElement}">
                <Border Width="100" Height="100" CornerRadius="50" Background="{DynamicResource SuccessBrush}" Margin="0,0,0,32" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource SuccessColor}" BlurRadius="30" Opacity="0.4" ShadowDepth="0"/>
                    </Border.Effect>
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" Foreground="#064E3B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Installation Complete!" Style="{DynamicResource TitleText}" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="16" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Launching SteamVault..." FontSize="15" Foreground="{DynamicResource DimText}" HorizontalAlignment="Center" FontStyle="Italic"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
