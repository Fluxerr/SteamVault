<UserControl x:Class="SteamVault.Views.MyGamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SteamVault.ViewModels"
             xmlns:converters="clr-namespace:SteamVault.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:MyGamesViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="860">
    <UserControl.Resources>
        <converters:InvertibleBoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:EqualityConverter x:Key="EqualityConverter" />

        <Style x:Key="ToggleIconStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DimText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBase}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="ToggleTextStyle" TargetType="RadioButton" BasedOn="{StaticResource ToggleIconStyle}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <DataTemplate x:Key="GameCardTemplate">
            <Border x:Name="LibraryCard" Margin="6" Background="{DynamicResource SurfaceBase}" BorderThickness="0" CornerRadius="12" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="GameCard_Click" RenderTransformOrigin="0.5,0.5" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Export Configuration" Command="{Binding DataContext.ExportSingleGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <MenuItem Header="Re-apply Manifests" Command="{Binding DataContext.RestoreManifestsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <MenuItem Header="Delete Configuration" Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="{DynamicResource ErrorBrush}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Image container with 460:215 aspect ratio -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource SurfaceRaised}" Height="120"/>
                            <Image x:Name="CardImage" Source="{Binding HeaderImageUrl}" Stretch="UniformToFill" Height="120" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource FadeInImage}">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>
                            
                            <!-- Gradient scrim -->
                            <Border VerticalAlignment="Bottom" Height="50">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#CC1A1A1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            
                            <!-- Install Status Indicator -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10" Width="10" Height="10" CornerRadius="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Border>

                        <StackPanel Grid.Row="1" Margin="14,10,14,14">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource DimText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                    <!-- Selection Overlay -->
                    <Border Grid.RowSpan="2" x:Name="SelectionOverlay" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="2" CornerRadius="12" Background="#1A000000" Opacity="0" IsHitTestVisible="False">
                        <Border x:Name="TickBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="{DynamicResource PrimaryAccent}" CornerRadius="12" Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                            </Border.RenderTransform>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="LibraryCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="LibraryCard" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LibraryCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LibraryCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                
                <DataTrigger Binding="{Binding IsSelectedForExport}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SelectionOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="TickBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="TickBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SelectionOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="TickBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.5" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="TickBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.5" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Top Scanning Bar -->
        <Border Height="3" Background="{DynamicResource PrimaryAccent}" VerticalAlignment="Top" Panel.ZIndex="10"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" AutoReverse="True" Duration="0:0:0.8"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="48,40,48,40">
                <!-- ═══ LIBRARY GRID ═══ -->
                <Grid Visibility="{Binding ShowGameDetail, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Library" Style="{DynamicResource TitleText}"/>
                        <TextBlock Text="Your locally managed SteamVault configurations and installed games." Style="{DynamicResource SubtitleText}"/>
                    </StackPanel>

                    <!-- Unified Library Top Bar Container -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Margin="0,0,0,16" ClipToBounds="True">
                        <Grid>
                            <!-- Theme Decoration Background -->
                            <Rectangle Fill="{DynamicResource ThemeTopBarDecoration}" IsHitTestVisible="False"/>
                            <Grid Margin="10,8">
                                <!-- Left Controls: Filter, View Mode, Sort Mode -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="180" Height="36" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="Filter library..." Margin="0,0,10,0"/>

                                <!-- View Mode Segmented Control with Sliding Background Pill -->
                                <Border Background="{DynamicResource SurfaceBase}" CornerRadius="8" Padding="3" Margin="0,0,10,0" Height="36">
                                    <Grid>
                                        <!-- Sliding Indicator Pill -->
                                        <Border x:Name="ViewModeIndicator" Width="36" Height="30" Background="{DynamicResource SurfaceRaised}" CornerRadius="6" HorizontalAlignment="Left">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.2"/>
                                            </Border.Effect>
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="ViewModeTranslate" X="0"/>
                                            </Border.RenderTransform>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="ViewModeGroup" IsChecked="{Binding ViewMode, Converter={StaticResource EqualityConverter}, ConverterParameter='Grid'}" 
                                                         Command="{Binding SetViewModeCommand}" CommandParameter="Grid" Style="{StaticResource SlidingToggleIconStyle}" ToolTip="Grid View">
                                                <RadioButton.Triggers>
                                                    <EventTrigger RoutedEvent="RadioButton.Checked">
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ViewModeTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </RadioButton.Triggers>
                                                <Path Data="M0,0 H4 V4 H0 Z M6,0 H10 V4 H6 Z M0,6 H4 V10 H0 Z M6,6 H10 V10 H6 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="12" Height="12" Stretch="Uniform" />
                                            </RadioButton>
                                            <RadioButton GroupName="ViewModeGroup" IsChecked="{Binding ViewMode, Converter={StaticResource EqualityConverter}, ConverterParameter='List'}" 
                                                         Command="{Binding SetViewModeCommand}" CommandParameter="List" Style="{StaticResource SlidingToggleIconStyle}" ToolTip="List View">
                                                <RadioButton.Triggers>
                                                    <EventTrigger RoutedEvent="RadioButton.Checked">
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ViewModeTranslate" Storyboard.TargetProperty="X" To="36" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </RadioButton.Triggers>
                                                <Path Data="M0,0 H10 V2 H0 Z M0,4 H10 V6 H0 Z M0,8 H10 V10 H0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="12" Height="12" Stretch="Uniform" />
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Sort Mode Segmented Control with Sliding Background Pill -->
                                <Border Background="{DynamicResource SurfaceBase}" CornerRadius="8" Padding="3" Margin="0,0,10,0" Height="36">
                                    <Grid>
                                        <!-- Sliding Indicator Pill -->
                                        <Border x:Name="SortModeIndicator" Width="60" Height="30" Background="{DynamicResource SurfaceRaised}" CornerRadius="6" HorizontalAlignment="Left">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.2"/>
                                            </Border.Effect>
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="SortModeTranslate" X="0"/>
                                            </Border.RenderTransform>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="SortModeGroup" Content="Name" Width="60" IsChecked="{Binding SortMode, Converter={StaticResource EqualityConverter}, ConverterParameter='Name'}" Command="{Binding SetSortModeCommand}" CommandParameter="Name" Style="{StaticResource SlidingToggleTextStyle}">
                                                <RadioButton.Triggers>
                                                    <EventTrigger RoutedEvent="RadioButton.Checked">
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="SortModeTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="SortModeIndicator" Storyboard.TargetProperty="Width" To="60" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </RadioButton.Triggers>
                                            </RadioButton>
                                            <RadioButton GroupName="SortModeGroup" Content="Date" Width="60" IsChecked="{Binding SortMode, Converter={StaticResource EqualityConverter}, ConverterParameter='LastUpdated'}" Command="{Binding SetSortModeCommand}" CommandParameter="LastUpdated" Style="{StaticResource SlidingToggleTextStyle}">
                                                <RadioButton.Triggers>
                                                    <EventTrigger RoutedEvent="RadioButton.Checked">
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="SortModeTranslate" Storyboard.TargetProperty="X" To="60" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="SortModeIndicator" Storyboard.TargetProperty="Width" To="60" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </RadioButton.Triggers>
                                            </RadioButton>
                                            <RadioButton GroupName="SortModeGroup" Content="Size" Width="60" IsChecked="{Binding SortMode, Converter={StaticResource EqualityConverter}, ConverterParameter='Size'}" Command="{Binding SetSortModeCommand}" CommandParameter="Size" Style="{StaticResource SlidingToggleTextStyle}">
                                                <RadioButton.Triggers>
                                                    <EventTrigger RoutedEvent="RadioButton.Checked">
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="SortModeTranslate" Storyboard.TargetProperty="X" To="120" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="SortModeIndicator" Storyboard.TargetProperty="Width" To="60" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </RadioButton.Triggers>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Right Controls: Batch Export, Refresh, Re-apply Manifests -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding IsExportMode}" Height="36" Padding="12,6" Margin="0,0,8,0" ToolTip="Batch Export Mode">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryAccent}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Export" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </ToggleButton>

                                <Button Command="{Binding RefreshCommand}" Style="{DynamicResource DrawOutlineGhostButton}" Padding="12,6" Height="36" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RestoreAllManifestsCommand}" Style="{DynamicResource DrawOutlineGhostButton}" Padding="12,6" Height="36" ToolTip="Restores cached manifests to Steam depotcache and locks them against deletion by Steam.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="Re-apply Manifests" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </Border>

                    <!-- Export Toolbar -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="16,10" Margin="0,0,0,16"
                            Visibility="{Binding IsExportMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExportSelectedCount}" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="configurations selected for export." VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                            </StackPanel>
                            <Button Command="{Binding ExportSelectedCommand}" HorizontalAlignment="Right" Padding="20,8" Style="{DynamicResource DrawOutlineButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="Export to ZIP" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Status message -->
                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource DimText}" FontSize="13" Margin="0,0,0,16"/>

                    <!-- Empty State Watermark -->
                    <Rectangle Grid.Row="4" Fill="{DynamicResource ThemeTopBarDecoration}" Opacity="0.08" IsHitTestVisible="False" 
                               Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVis}}" 
                               Width="450" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <Rectangle.OpacityMask>
                            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="Black" Offset="0.2"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="4" Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVis}}" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock Text="&#xE814;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48" 
                                   Foreground="{DynamicResource SurfaceHover}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <TextBlock Text="Your vault is empty" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Games you configure via the Dashboard will appear here." Foreground="{DynamicResource MutedText}" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Grid View -->
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCardTemplate}" VerticalAlignment="Top">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasNoGames}" Value="False"/>
                                            <Condition Binding="{Binding ViewMode}" Value="Grid"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- List View -->
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Games}" VerticalAlignment="Top">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasNoGames}" Value="False"/>
                                            <Condition Binding="{Binding ViewMode}" Value="List"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="12" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="GameCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForExport}" VerticalAlignment="Center" Margin="0,0,16,0"
                                                  Visibility="{Binding DataContext.IsExportMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                        <Border Grid.Column="1" Width="100" Height="46" CornerRadius="4" ClipToBounds="True" Margin="0,0,16,0">
                                            <Image Source="{Binding HeaderImageUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="{Binding StatusBrush}" Opacity="0.2" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InstallStatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Table View -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Games}" AutoGenerateColumns="False" HeadersVisibility="Column" 
                              Background="Transparent" BorderThickness="0" RowBackground="Transparent" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SurfaceHover}"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasNoGames}" Value="False"/>
                                            <Condition Binding="{Binding ViewMode}" Value="Table"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForExport}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding DataContext.IsExportMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="App ID" Binding="{Binding AppId}" Width="100" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstallStatusText}" Width="120" />
                            <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdated, StringFormat='{}{0:d}'}" Width="100" />
                        </DataGrid.Columns>
                        <DataGrid.ItemContainerStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <EventSetter Event="MouseLeftButtonDown" Handler="GameCard_Click"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.ItemContainerStyle>
                    </DataGrid>
                </Grid>

                <!-- ═══ GAME DETAIL VIEW ═══ -->
                <Border Visibility="{Binding ShowGameDetail, Converter={StaticResource BoolToVis}}" Padding="0" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGameDetail}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="40,0,0,0" To="0" Duration="0:0:0.35">
                                                    <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Banner -->
                        <Grid Grid.Row="0">
                            <Border Background="{DynamicResource SurfaceRaised}"/>
                            <Image Source="{Binding SelectedGame.HeaderImageUrl}" Stretch="UniformToFill" Style="{DynamicResource FadeInImage}"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33000000" Offset="0"/>
                                        <GradientStop Color="#F21A1A1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,24">
                                <Button Command="{Binding BackToGridCommand}" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Padding="8,4" Margin="-8,0,0,16" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Back to Library" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding SelectedGame.Name}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Content Area -->
                        <Grid Grid.Row="1" Margin="40,24,40,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Info -->
                            <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                <WrapPanel Margin="0,0,0,20">
                                    <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding SelectedGame.AppId, StringFormat='ID: {0}'}" Style="{DynamicResource MonoText}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                    </Border>
                                    <!-- Install Status Pill -->
                                    <Border CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#33FBBF24"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="True">
                                                        <Setter Property="Background" Value="#3334D399"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedGame.InstallStatusText}" FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <!-- Update Status Pill -->
                                    <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding SelectedGame.Status}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="{Binding SelectedGame.Description}" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="{DynamicResource MutedText}" Margin="0,0,0,20" MaxHeight="88" TextTrimming="CharacterEllipsis"/>

                                <!-- System Compatibility Badge -->
                                <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Background="{DynamicResource SurfaceHover}"
                                        Visibility="{Binding SelectedGame.HasCompatibilityData, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="{Binding SelectedGame.CompatibilityBadgeColor}" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedGame.CompatibilityRating, StringFormat='COMPATIBILITY: {0}'}" 
                                                           Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                            <TextBlock Text="{Binding SelectedGame.CompatibilityText}" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Requirements vs Your System Comparison Table -->
                                        <Border Background="{DynamicResource SurfaceBase}" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="1"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Table Header -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="SPEC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DimText}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="GAME REQUIREMENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="YOUR SYSTEM SPECS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>

                                                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceHover}" Margin="0,6,0,8"/>

                                                <!-- RAM Row -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,6">
                                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="RAM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGame.GameReqRam}" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,2,10,6" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedGame.UserRamText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Top" Margin="0,2,0,6" TextWrapping="Wrap"/>

                                                <!-- CPU Row -->
                                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,6">
                                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedGame.GameReqCpu}" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,2,10,6" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SelectedGame.UserCpuName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Top" Margin="0,2,0,6" TextWrapping="Wrap"/>

                                                <!-- GPU Row -->
                                                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="GPU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedGame.GameReqGpu}" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Top" Margin="0,2,10,0" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SelectedGame.UserGpuName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Top" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- HowLongToBeat Stats Grid -->
                                <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,20" Background="{DynamicResource SurfaceHover}"
                                        Visibility="{Binding SelectedGame.HasHltbData, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Text="HOW LONG TO BEAT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                                        </StackPanel>
                                        <WrapPanel>
                                            <Border Background="{DynamicResource SurfaceBase}" CornerRadius="6" Padding="10,6" Margin="0,0,10,6">
                                                <StackPanel>
                                                    <TextBlock Text="Main Story" FontSize="10" Foreground="{DynamicResource DimText}"/>
                                                    <TextBlock Text="{Binding SelectedGame.HltbMainStory}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBase}" CornerRadius="6" Padding="10,6" Margin="0,0,10,6">
                                                <StackPanel>
                                                    <TextBlock Text="Main + Extra" FontSize="10" Foreground="{DynamicResource DimText}"/>
                                                    <TextBlock Text="{Binding SelectedGame.HltbMainExtra}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBase}" CornerRadius="6" Padding="10,6" Margin="0,0,10,6">
                                                <StackPanel>
                                                    <TextBlock Text="Completionist" FontSize="10" Foreground="{DynamicResource DimText}"/>
                                                    <TextBlock Text="{Binding SelectedGame.HltbCompletionist}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Detail Grid -->
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TYPE" Foreground="{DynamicResource DimText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedGame.Type}" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="0,0,0,16"/>
                                        
                                        <TextBlock Text="DEPOTS" Foreground="{DynamicResource DimText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedGame.Depots.Count}" Style="{DynamicResource MonoText}" FontSize="13" Foreground="{DynamicResource MutedText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RELEASED" Foreground="{DynamicResource DimText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedGame.ReleaseDate}" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="0,0,0,16"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Keys Section -->
                                <StackPanel Visibility="{Binding SelectedGame.AppTicket, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <TextBlock Text="DRM KEYS" Foreground="{DynamicResource DimText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    
                                    <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                            Visibility="{Binding SelectedGame.AppTicket, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="AppTicket" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding SelectedGame.AppTicket, Mode=OneWay}" IsReadOnly="True" 
                                                     FontFamily="pack://application:,,,/Fonts/#JetBrains Mono, Consolas, monospace" FontSize="12" Foreground="{DynamicResource PrimaryAccent}" Background="Transparent" BorderThickness="0"
                                                     TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>
                                    
                                    <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                            Visibility="{Binding SelectedGame.ETicket, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="ETicket" Foreground="{DynamicResource MutedText}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding SelectedGame.ETicket, Mode=OneWay}" IsReadOnly="True" 
                                                     FontFamily="pack://application:,,,/Fonts/#JetBrains Mono, Consolas, monospace" FontSize="12" Foreground="{DynamicResource PrimaryAccent}" Background="Transparent" BorderThickness="0"
                                                     TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding DetailStatusMessage}" Foreground="{DynamicResource DimText}" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Right Actions -->
                            <StackPanel Grid.Column="1">
                                <Button Content="Launch Game" Command="{Binding LaunchGameCommand}" CommandParameter="{Binding SelectedGame}" Margin="0,0,0,12"/>
                                <Button Content="Update Config (Disabled)" Command="{Binding UpdateGameCommand}" CommandParameter="{Binding SelectedGame}" IsEnabled="False" Style="{DynamicResource GhostButton}" Margin="0,0,0,12" ToolTip="Config updates are currently unavailable."/>
                                <Button Content="Re-apply Manifests" Command="{Binding RestoreManifestsCommand}" CommandParameter="{Binding SelectedGame}" Style="{DynamicResource DrawOutlineGhostButton}" Margin="0,0,0,12" ToolTip="Restores cached manifests for this game to Steam depotcache and locks them against deletion."/>
                                <Button Content="Open Install Folder" Command="{Binding OpenInstallFolderCommand}" CommandParameter="{Binding SelectedGame}" Style="{DynamicResource DrawOutlineGhostButton}" Margin="0,0,0,12"/>
                                <Button Content="Open Lua Folder" Command="{Binding OpenLuaFolderCommand}" CommandParameter="{Binding SelectedGame}" Style="{DynamicResource DrawOutlineGhostButton}" Margin="0,0,0,24"/>
                                
                                <Button Command="{Binding DeleteGameCommand}" CommandParameter="{Binding SelectedGame}" Background="Transparent" Foreground="{DynamicResource ErrorBrush}" BorderThickness="0" Padding="0" HorizontalAlignment="Right" FontSize="13" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="DelText" Text="Delete Config" TextDecorations="Underline" Cursor="Hand" Foreground="{DynamicResource ErrorBrush}" Opacity="0.7"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DelText" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
