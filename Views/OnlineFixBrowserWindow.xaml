<Window x:Class="SteamVault.Views.OnlineFixBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Online-Fix Browser" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Text}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Border frame overlay (visual only, never blocks input) -->
        <Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsHitTestVisible="False"/>

            <!-- Custom Title Bar -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource SurfaceRaised}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Navigation Buttons + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Width="30" Height="30" Click="BackButton_Click" Cursor="Hand" ToolTip="Back" Margin="0,0,2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="30" Height="30" Click="ForwardButton_Click" Cursor="Hand" ToolTip="Forward" Margin="0,0,2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="30" Height="30" Click="RefreshButton_Click" Cursor="Hand" ToolTip="Refresh" Margin="0,0,10,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DimText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccent}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Online-Fix.me" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}"/>
                    </StackPanel>

                    <!-- Center: URL bar (read-only display) -->
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBase}" CornerRadius="4" Margin="12,5" Padding="8,0" VerticalAlignment="Center" Opacity="0.6">
                        <TextBlock x:Name="UrlBar" Text="" FontSize="11" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Right: Close button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CloseButton" Width="46" Height="36" Click="CloseButton_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent">
                                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource DimText}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#33F87171"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.Row="1" Background="{DynamicResource WindowBackground}" Panel.ZIndex="10" Visibility="Visible" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SurfaceRaised}" Margin="0,0,0,20">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" CenterX="12" CenterY="12"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Border>
                <TextBlock Text="Initializing Secure Browser..." FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                <TextBlock Text="Cloudflare bypass active — this may take a moment" FontSize="13" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Notification Toast -->
        <Border x:Name="NotificationToast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="{DynamicResource SuccessBrush}" CornerRadius="20" Padding="20,10" Panel.ZIndex="20"
                Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.3" ShadowDepth="4"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="20"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="NotificationText" Text="" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- WebView2: placed directly in the Grid with no clipping container.
             HwndHost needs an unclipped parent so its native HWND coordinate space
             matches the WPF layout exactly. -->
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" Visibility="Hidden" Focusable="True"/>
    </Grid>
</Window>