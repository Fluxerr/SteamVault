<UserControl x:Class="SteamVault.Views.OnlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SteamVault.ViewModels"
             xmlns:converters="clr-namespace:SteamVault.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:OnlineViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="860">
    <UserControl.Resources>
        <converters:InvertibleBoolToVisibilityConverter x:Key="BoolToVis" />
        
        <DataTemplate x:Key="OnlineCardTemplate">
            <Border x:Name="OnlineCard" Margin="8" Background="{DynamicResource SurfaceBase}" BorderThickness="0" CornerRadius="16" ClipToBounds="True" Cursor="Hand" RenderTransformOrigin="0.5,0.5" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource SurfaceRaised}" />
                            <Image x:Name="CardImage" Source="{Binding HeaderImageUrl}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource FadeInImage}">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>
                            
                            <Border VerticalAlignment="Bottom" Height="80">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#E61A1A1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            
                            <!-- Badges -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,12">
                                <Border Background="{DynamicResource PrimaryAccent}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" Visibility="{Binding HasOnlineFix, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Online Fix" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <Border Background="{DynamicResource SuccessBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" Visibility="{Binding HasBypass, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Bypass" FontSize="11" FontWeight="Bold" Foreground="#064E3B" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="16,12,16,16">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <Border x:Name="IdPill" Background="{DynamicResource SurfaceHover}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Opacity="0">
                            <TextBlock Text="{Binding AppId, StringFormat='ID: {0}'}" Style="{DynamicResource MonoText}" FontSize="11" Foreground="{DynamicResource DimText}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="OnlineCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="OnlineCard" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="OnlineCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.25"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="IdPill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="OnlineCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="CardImage" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="IdPill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border Height="3" Background="{DynamicResource PrimaryAccent}" VerticalAlignment="Top" 
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" AutoReverse="True" Duration="0:0:0.8"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="48,40,48,40">
                <Grid Visibility="{Binding ShowGameGrid, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Fixes" Style="{DynamicResource TitleText}"/>
                            <Border Background="{DynamicResource PrimaryAccent}" CornerRadius="4" Padding="6,2" Margin="12,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="Powered by LuaTools" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Download and apply online multiplayer fixes and bypasses." Style="{DynamicResource SubtitleText}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Unified Fixes Top Bar Container -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Margin="0,0,0,16" ClipToBounds="True">
                        <Grid>
                            <!-- Theme Decoration Background -->
                            <Rectangle Fill="{DynamicResource ThemeTopBarDecoration}" IsHitTestVisible="False"/>
                            <Grid Margin="10,8">
                                <!-- Left Controls: Search, Filter Segmented Control -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Width="180" Height="36" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Tag="Search fixes..." Margin="0,0,10,0"/>

                                <!-- Filter Segmented Control with Sliding Background Pill -->
                                <Border Background="{DynamicResource SurfaceBase}" CornerRadius="8" Padding="3" Margin="0,0,10,0" Height="36">
                                    <Grid>
                                        <!-- Sliding Indicator Pill -->
                                        <Border x:Name="FixesFilterIndicator" Width="50" Height="30" Background="{DynamicResource SurfaceRaised}" CornerRadius="6" HorizontalAlignment="Left">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.2"/>
                                            </Border.Effect>
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="FixesFilterTranslate" X="0"/>
                                            </Border.RenderTransform>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton GroupName="FixesFilterGroup" Content="All" Width="50" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='All'}" Command="{Binding FilterCommand}" CommandParameter="All" Style="{StaticResource SlidingToggleTextStyle}">
                                                <RadioButton.Triggers>
                                                    <EventTrigger RoutedEvent="RadioButton.Checked">
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FixesFilterTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="FixesFilterIndicator" Storyboard.TargetProperty="Width" To="50" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </RadioButton.Triggers>
                                            </RadioButton>
                                            <RadioButton GroupName="FixesFilterGroup" Content="Bypasses" Width="90" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='Bypasses'}" Command="{Binding FilterCommand}" CommandParameter="Bypasses" Style="{StaticResource SlidingToggleTextStyle}">
                                                <RadioButton.Triggers>
                                                    <EventTrigger RoutedEvent="RadioButton.Checked">
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FixesFilterTranslate" Storyboard.TargetProperty="X" To="50" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="FixesFilterIndicator" Storyboard.TargetProperty="Width" To="90" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </RadioButton.Triggers>
                                            </RadioButton>
                                            <RadioButton GroupName="FixesFilterGroup" Content="Online Fixes" Width="110" IsChecked="{Binding CurrentFilter, Converter={StaticResource EqualityConverter}, ConverterParameter='Online Fixes'}" Command="{Binding FilterCommand}" CommandParameter="Online Fixes" Style="{StaticResource SlidingToggleTextStyle}">
                                                <RadioButton.Triggers>
                                                    <EventTrigger RoutedEvent="RadioButton.Checked">
                                                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="FixesFilterTranslate" Storyboard.TargetProperty="X" To="140" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="FixesFilterIndicator" Storyboard.TargetProperty="Width" To="110" Duration="0:0:0.25">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </RadioButton.Triggers>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Right Controls: Discord Sign In & Refresh -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding OpenSignInModalCommand}" Margin="0,0,8,0" Style="{DynamicResource DrawOutlineGhostButton}" Padding="12,6" Height="36">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#5865F2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding UserDisplayName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Sign In with Discord" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RefreshCommand}" Style="{DynamicResource DrawOutlineGhostButton}" Padding="12,6" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </Border>

                    <!-- Empty State Watermark -->
                    <Rectangle Grid.Row="2" Fill="{DynamicResource ThemeTopBarDecoration}" Opacity="0.08" IsHitTestVisible="False" 
                               Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVis}}" 
                               Width="450" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <Rectangle.OpacityMask>
                            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="Black" Offset="0.2"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="2" Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVis}}" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48" 
                                   Foreground="{DynamicResource SurfaceHover}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <TextBlock Text="No Fixes Found" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="You have no online-capable games in your library." Foreground="{DynamicResource MutedText}" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Games}" ItemTemplate="{StaticResource OnlineCardTemplate}" Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <Border Visibility="{Binding ShowGameDetail, Converter={StaticResource BoolToVis}}" Padding="0" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGameDetail}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,30,0,0" To="0" Duration="0:0:0.35">
                                                    <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Banner -->
                        <Grid Grid.Row="0">
                            <Border Background="{DynamicResource SurfaceRaised}"/>
                            <Image Source="{Binding SelectedGame.HeaderImageUrl}" Stretch="UniformToFill" Style="{DynamicResource FadeInImage}"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33000000" Offset="0"/>
                                        <GradientStop Color="#F21A1A1F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,24">
                                <Button Command="{Binding BackToGridCommand}" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Padding="8,4" Margin="-8,0,0,16" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Back to Games" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding SelectedGame.Name}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="40,24,40,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,48,0">
                                <WrapPanel Margin="0,0,0,24">
                                    <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding SelectedGame.AppId, StringFormat='ID: {0}'}" Style="{DynamicResource MonoText}" FontSize="12" Foreground="{DynamicResource MutedText}"/>
                                    </Border>
                                    <Border CornerRadius="6" Padding="10,4" Margin="0,0,8,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#33FBBF24"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGame.FixApplied}" Value="True">
                                                        <Setter Property="Background" Value="#3334D399"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedGame.Status}" FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.FixApplied}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>
                                
                                <ItemsControl ItemsSource="{Binding SelectedGameFixes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedText}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                                    
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Download Manifest" Command="{Binding DataContext.DownloadBypassCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0" Style="{DynamicResource DrawOutlineButton}" Visibility="{Binding HasManifest, Converter={StaticResource BoolToVis}}"/>
                                                        <Button Command="{Binding DataContext.DownloadOnlineFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource DrawOutlineGhostButton}">
                                                                    <Setter Property="Content" Value="Download Online Fix"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.SelectedGame.HasBypass, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                            <Setter Property="Content" Value="Download Bypass"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DataContext.SelectedGame.HasOnlineFix, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                            <Setter Property="Content" Value="Download Online Fix"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button Content="Open Game Folder" Command="{Binding OpenGameDirCommand}" CommandParameter="{Binding SelectedGame}" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" Visibility="{Binding SelectedGame.IsInstalled, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <Border CornerRadius="8" Padding="16,12" Background="#33FBBF24" Margin="0,0,0,16" Visibility="{Binding IsAdminRequired, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Admin rights required" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="Grant Admin Permissions" Command="{Binding RestartAsAdminCommand}" Height="36"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="8" Padding="16,12" Background="#33FBBF24" Margin="0,0,0,16" Visibility="{Binding SelectedGame.IsInstalled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="Game is not installed. Install via Steam first." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="{Binding DetailStatusMessage}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="4,0,0,0"/>
                                <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="{DynamicResource DimText}" FontSize="12" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
    </Grid>
</UserControl>
