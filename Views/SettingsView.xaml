<UserControl x:Class="SteamVault.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SteamVault.ViewModels"
             xmlns:converters="clr-namespace:SteamVault.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900">
             
    <UserControl.Resources>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="48,40,48,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings Watermark -->
        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource ThemeTopBarDecoration}" Opacity="0.12" IsHitTestVisible="False" 
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="600" Height="600" Margin="0,0,-150,-150">
            <Rectangle.OpacityMask>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="Black" Offset="0.2"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="Settings" Style="{DynamicResource TitleText}"/>
            <TextBlock Text="Manage background services, theme options, local directories, and the decryption key database." 
                       Style="{DynamicResource SubtitleText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">

                <Border Style="{DynamicResource SurfaceCard}" Margin="0,0,0,24" Padding="32,24">
                    <StackPanel>
                        <!-- User Profile -->
                        <TextBlock Text="User Profile &amp; Family Identity" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Display Name / Username" FontWeight="Medium" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="This name identifies you when contributing games and sharing with members in Family Vault." 
                                           Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="13" MaxWidth="500" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,8" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20"/>

                        <!-- Background Operations -->
                        <TextBlock Text="Background and Startup" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Automatic Background Updates" FontWeight="Medium" FontSize="14" Margin="0,0,8,0"/>
                                    <Border Background="#30F87171" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="TEMPORARILY DISABLED" Foreground="#EF4444" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Automatic background updates are currently under maintenance and temporarily disabled." 
                                           Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="13" MaxWidth="600" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" IsChecked="False" IsEnabled="False" VerticalAlignment="Center" ToolTip="Auto-updates are temporarily disabled."/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,24"/>

                        <!-- Steam Integration & Performance Features -->
                        <TextBlock Text="Steam Integration &amp; Performance" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>

                        <!-- Steam Turbo Downloader -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Steam Turbo Downloader Accelerator" FontWeight="Medium" FontSize="14" Margin="0,0,8,0"/>
                                    <Border Background="#3038BDF8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="TURBO SPEED" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Uncaps TCP receive socket buffers (4 MB) and boosts thread priorities for maximum bandwidth utilization when downloading game depots." 
                                           Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="13" MaxWidth="600" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitch}" IsChecked="{Binding TurboDownloaderEnabled}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,24"/>

                        <!-- Theme Selection -->
                        <TextBlock Text="Appearance" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>
                        <TextBlock Text="Choose a color palette. The UI immediately applies the selection." Foreground="{DynamicResource MutedText}" FontSize="13" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding ThemePreviews}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,16,16" CornerRadius="8" Cursor="Hand" Width="140"
                                            Background="{DynamicResource SurfaceRaised}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.ChangeThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                          CommandParameter="{Binding Name}"/>
                                        </Border.InputBindings>
                                        
                                        <StackPanel Margin="12">
                                            <!-- Preview Swatches -->
                                            <Grid Height="40" Margin="0,0,0,8" ClipToBounds="True">
                                                <Border CornerRadius="4" Background="{Binding BackgroundHex}"/>
                                                <Border Margin="24,12,8,8" CornerRadius="2" Background="{Binding SurfaceHex}"/>
                                                <Border Margin="8,8,0,0" Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding AccentHex}"/>
                                            </Grid>
                                            
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}"/>
                                                    <Border Margin="6,0,0,0" Background="{DynamicResource PrimaryAccent}" CornerRadius="4" Padding="4,2" 
                                                            Visibility="{Binding IsCommunity, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                        <TextBlock Text="COMMUNITY" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                                           Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Custom Accent Picker -->
                        <TextBlock Text="Custom Accent Color" FontWeight="Medium" FontSize="14" Margin="0,16,0,8"/>
                        <TextBlock Text="Override the theme's default accent color." Foreground="{DynamicResource MutedText}" FontSize="13" Margin="0,0,0,12"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ItemsControl ItemsSource="{Binding CustomAccentColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="CustomAccent" Margin="0,0,8,8" Cursor="Hand"
                                                     Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource EqualityConverter}" Mode="OneWay">
                                                    <Binding Path="DataContext.SelectedCustomAccent" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <Binding Path="." />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Grid Width="32" Height="32">
                                                        <Ellipse Fill="{Binding}" StrokeThickness="2">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Stroke" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                            <Setter Property="Stroke" Value="{DynamicResource Text}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <Button Grid.Column="1" Content="Clear Accent" Command="{Binding ClearAccentCommand}" 
                                    Style="{DynamicResource GhostButton}" VerticalAlignment="Top" Padding="12,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data & Backup Card -->
                <Border Style="{DynamicResource SurfaceCard}" Margin="0,0,0,24" Padding="32,24">
                    <StackPanel>
                        <TextBlock Text="Data and Configuration" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>
                        
                        <!-- Lua Export -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Text="Export Lua Configurations" FontWeight="Medium" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Bundle all managed Lua configs and depot manifests into a ZIP file." Foreground="{DynamicResource MutedText}" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ExportStatus}" Foreground="{DynamicResource SuccessBrush}" FontSize="13" Margin="0,8,0,0" FontWeight="Medium"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Export to ZIP" Command="{Binding ExportLuaCommand}" Width="160" Height="40" Style="{DynamicResource DrawOutlineGhostButton}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,24"/>

                        <!-- Key & Token Database -->
                        <TextBlock Text="Key and Token Database" FontWeight="Medium" FontSize="14" Margin="0,0,0,16"/>
                        <Border Background="{DynamicResource SurfaceHover}" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="{Binding DatabaseStats}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,4" FontWeight="Medium"/>
                                <TextBlock Text="{Binding KeySourceDetails}" Foreground="{DynamicResource MutedText}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Text="Update Database" FontWeight="Medium" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SyncStatusMessage}" Foreground="{DynamicResource DimText}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Check for Updates" Command="{Binding SyncDatabaseCommand}" Width="180" Height="40" Style="{DynamicResource DrawOutlineGhostButton}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Text="Force Rescan Sources" FontWeight="Medium" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RescanStatusMessage}" Foreground="{DynamicResource DimText}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Rescan All Sources" Command="{Binding RescanKeysCommand}" Width="180" Height="40" Style="{DynamicResource DrawOutlineGhostButton}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System Directories -->
                <Border Style="{DynamicResource SurfaceCard}" Margin="0,0,0,24" Padding="32,24">
                    <StackPanel>
                        <TextBlock Text="Local Directories" Style="{DynamicResource SectionHeader}" Margin="0,0,0,24"/>
                        
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Steam Main Directory" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="13"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.SteamDirectory, Mode=TwoWay}" Height="48" Tag="C:\Program Files (x86)\Steam" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono, Consolas, monospace"/>
                        </Grid>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Lua Target Path" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="13"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.LuaOutputPath, Mode=TwoWay}" Height="48" Tag="C:\Program Files (x86)\Steam\config\lua" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono, Consolas, monospace"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Manifest Depotcache Path" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="13"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.DepotcachePath, Mode=TwoWay}" Height="48" Tag="C:\Program Files (x86)\Steam\config\depotcache" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono, Consolas, monospace"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Discord -->
                <Border Background="#1A5865F2" CornerRadius="12" Padding="32,24" Margin="0,0,0,48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                            <TextBlock Text="Join the SteamVault Discord" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" Foreground="#A5B4FC"/>
                            <TextBlock Text="Request missing decryption keys, report bugs, or get help from the community." Foreground="#A5B4FC" FontSize="13" TextWrapping="Wrap" Opacity="0.8"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open Discord" Command="{Binding JoinDiscordCommand}" Width="160" Height="40" VerticalAlignment="Center" Style="{DynamicResource DrawOutlineGhostButton}"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Save Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBase}" BorderBrush="{DynamicResource SurfaceHover}" BorderThickness="0,1,0,0" Margin="-48,24,-48,-40" Padding="48,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" FontWeight="Medium" FontSize="14"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="What's New" Command="{Binding ShowWhatsNewCommand}" Margin="0,0,16,0" Padding="20,10" Style="{DynamicResource DrawOutlineGhostButton}"/>
                    <Button Content="Save Changes" Command="{Binding SaveCommand}" Width="160" Height="44" Style="{DynamicResource DrawOutlineButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
