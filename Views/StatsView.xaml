<UserControl x:Class="SteamVault.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:SteamVault.ViewModels"
             xmlns:converters="clr-namespace:SteamVault.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:StatsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:MathConverter x:Key="MathConverter"/>
        
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentMuted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="48,40,48,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Vault Analytics" Style="{DynamicResource TitleText}"/>
                <TextBlock Text="Insights and statistics about your game collection." Foreground="{DynamicResource MutedText}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{DynamicResource GhostButton}" Width="120" Height="40">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 1: Stat Cards -->
        <Grid Grid.Row="1" Margin="0,0,-16,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Games -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Total Games" Foreground="{DynamicResource MutedText}" FontSize="13" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock Text="{Binding TotalGamesConfigured}" Foreground="{DynamicResource Text}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="&#xE8F1; In your vault" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- DLCs Unlocked -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="DLCs Unlocked" Foreground="{DynamicResource MutedText}" FontSize="13" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock Text="{Binding TotalDlcsUnlocked}" Foreground="{DynamicResource Text}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="&#xE8F2; Extra content" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Money Saved -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Money Saved" Foreground="{DynamicResource MutedText}" FontSize="13" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock Text="{Binding FormattedMoneySaved}" Foreground="{DynamicResource Text}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="&#xE8D5; Estimated value" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Vault Size -->
            <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock Text="Vault Size" Foreground="{DynamicResource MutedText}" FontSize="13" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock Text="{Binding FormattedDiskUsage}" Foreground="{DynamicResource Text}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="&#xE7F3; Lua + Manifests" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource DimText}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2 & 3: Charts and Details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Timeline Chart Area (Placeholder for custom drawing in code-behind or ItemsControl) -->
            <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="24" Margin="0,0,16,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Activity Timeline" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>
                    
                    <!-- Basic Bar Chart implemented with ItemsControl -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthlyCounts}" VerticalAlignment="Stretch" Height="180">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Bottom" Margin="8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Border Grid.Row="0" Background="{DynamicResource PrimaryAccent}" CornerRadius="6,6,0,0"
                                            Height="{Binding Count, Converter={StaticResource MathConverter}}" 
                                            MinHeight="6" MaxHeight="150" VerticalAlignment="Bottom" Opacity="0.9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryAccentLight}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ToolTip>
                                            <ToolTip Content="{Binding Count, StringFormat='{}Downloaded {0} games'}" Background="{DynamicResource SurfaceRaised}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                        </Border.ToolTip>
                                    </Border>
                                    
                                    <TextBlock Grid.Row="1" Text="{Binding Month}" FontSize="12" Foreground="{DynamicResource DimText}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,0">
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Genre Breakdown -->
            <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="24" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Top Genres" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>
                    
                    <ItemsControl ItemsSource="{Binding GenreBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{Binding ColorBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Genre}" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource DimText}" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Top Games -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Background="{DynamicResource SurfaceRaised}" CornerRadius="12" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Top Downloaded Games" Style="{DynamicResource SectionHeader}" Margin="0,0,0,16"/>
                    
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="-8,0">
                        <ItemsControl ItemsSource="{Binding TopGames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="240" Background="{DynamicResource SurfaceBase}" CornerRadius="12" Margin="8,8,16,16" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentMuted}"/>
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border CornerRadius="8" ClipToBounds="True" Height="110" Margin="0,0,0,16">
                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" Foreground="{DynamicResource DimText}" FontSize="12" Margin="0,4,0,12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryAccent}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DownloadCount}" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Text=" total downloads" Foreground="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
        
        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000" CornerRadius="12" 
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{DynamicResource PrimaryAccent}"/>
                <TextBlock Text="Crunching numbers..." Foreground="White" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
