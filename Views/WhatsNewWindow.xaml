<Window x:Class="SteamVault.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SteamVault.Views"
        mc:Ignorable="d"
        Title="What's New in SteamVault" Height="560" Width="680"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Custom Visible ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border x:Name="Bg" Background="#14FFFFFF" CornerRadius="5" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="5" Background="{DynamicResource PrimaryAccent}" Opacity="0.8" Width="8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Solid theme window background (WindowBackground) -->
    <Border Background="{DynamicResource WindowBackground}" CornerRadius="16" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SurfaceBase}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/SteamVault;component/SteamVault.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Title & Version Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="What's New" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,10,0"/>
                        <!-- Version Pill Badge -->
                        <Border CornerRadius="10" Background="{DynamicResource PrimaryAccent}" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="12" FontWeight="ExtraBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ReleaseSubtitle}" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Close Window Button -->
                <Button Grid.Column="2" Content="✕" Width="32" Height="32" VerticalAlignment="Top" 
                        Background="Transparent" Foreground="{DynamicResource MutedText}" BorderThickness="0" 
                        FontSize="16" FontWeight="Bold" Cursor="Hand" Click="ContinueButton_Click" ToolTip="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Release Notes List Container -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBase}" CornerRadius="12" Padding="16,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Title + Tag Row -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Tag Badge Pill -->
                                            <Border CornerRadius="8" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2D3139"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag}" Value="NEW">
                                                                <Setter Property="Background" Value="#283B28"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag}" Value="PERFORMANCE">
                                                                <Setter Property="Background" Value="#3B2844"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag}" Value="SPEED">
                                                                <Setter Property="Background" Value="#3B2844"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag}" Value="IMPROVED">
                                                                <Setter Property="Background" Value="#1E2E3B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag}" Value="THEME">
                                                                <Setter Property="Background" Value="#3B321E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag}" Value="FIXED">
                                                                <Setter Property="Background" Value="#442E28"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="ExtraBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#F8F8F2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tag}" Value="NEW">
                                                                    <Setter Property="Foreground" Value="#A6E22E"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="PERFORMANCE">
                                                                    <Setter Property="Foreground" Value="#BD93F9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="SPEED">
                                                                    <Setter Property="Foreground" Value="#BD93F9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="IMPROVED">
                                                                    <Setter Property="Foreground" Value="#66D9EF"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="THEME">
                                                                    <Setter Property="Foreground" Value="#E6DB74"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag}" Value="FIXED">
                                                                    <Setter Property="Foreground" Value="#FF922B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Item Title -->
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Item Description -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource MutedText}" 
                                                   TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Bottom Action Footer -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="SteamVault updates automatically in the background." FontSize="12" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>

                <!-- Prominent, Tall Action Button -->
                <Button Grid.Column="1" Content="Explore SteamVault" Height="46" MinWidth="200"
                        Background="{DynamicResource PrimaryAccent}" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14"
                        Click="ContinueButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="28,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
